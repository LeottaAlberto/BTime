{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🔥 BTime: Fullstack (Hot Reload C# + TS)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/frontend/btime",
            "preLaunchTask": "start-servers",
            "sourceMaps": true
        },
        {
            "name": "🔥 BTime: Solo Frontend (Hot Reload)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/frontend/btime",
            "preLaunchTask": "start-frontend",
            "sourceMaps": true
        },
        {
            "name": "🔥 BTime: Solo Backend (Hot Reload)",
            "type": "chrome",
            "request": "launch",
            "url": "https://localhost:7255/swagger",
            "preLaunchTask": "watch-backend"
        },
        {
            "name": "🐞 BTime: Collega Debugger C# (Attach)",
            "type": "coreclr",
            "request": "attach",
            "processName": "dotnet"
        }
    ],
    "compounds": [
        {
            "name": "🚀 Avvia BTime (Fullstack + Browser)",
            "configurations": [
                "🔥 BTime: Solo Backend (Hot Reload)",
                "🔥 BTime: Solo Frontend (Hot Reload)"
            ],
            "stopAll": true
        }
    ]
}