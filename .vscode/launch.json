{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🔥 BTime: Backend",
            "type": "coreclr",
            "request": "attach",
            "processName": "BTime.Api",
            "preLaunchTask": "watch-backend"
        },
        {
            "name": "🔥 BTime: Solo Frontend",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/frontend/btime",
            "preLaunchTask": "start-frontend",
            "sourceMaps": true
        },
        {
            "name": "🐞 BTime: Backend (Attach a processo esistente)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "🐞 BTime: Backend (Debug Classico F5)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/backend/BTime.Api/bin/Debug/net10.0/BTime.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/BTime.Api",
            "stopAtEntry": false,
            "preLaunchTask": "build-backend",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ],
    "compounds": [
        {
            "name": "🚀 Avvia BTime: Fullstack (Debug C# + Frontend + Hot Reload)",
            "configurations": [
                "🔥 BTime: Backend",
                "🔥 BTime: Solo Frontend"
            ],
            "stopAll": true
        }
    ]
}