{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-db",
            "type": "shell",
            "command": "docker compose up -d",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "watch-backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/backend/BTime.Api/BTime.Api.csproj",
                "-lp",
                "https",
                "--non-interactive"
            ],
            "dependsOn": [
                "start-db"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*(Hot reload|Building|Watch|Started|dotnet watch).*",
                    "endsPattern": ".*(Now listening on|Application started).*"
                }
            },
            "presentation": {
                "panel": "dedicated",
                "group": "servers"
            }
        },
        {
            "label": "build-backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/backend/BTime.Api/BTime.Api.csproj"
            ],
            "dependsOn": [
                "start-db"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "start-frontend",
            "type": "npm",
            "script": "start",
            "path": "frontend/btime",
            "isBackground": true,
            "problemMatcher": {
                "owner": "angular",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*(Local:|localhost:4200|Application bundle generation complete).*"
                }
            },
            "presentation": {
                "panel": "dedicated",
                "group": "servers"
            }
        },
        {
            "label": "start-servers",
            "dependsOn": [
                "watch-backend",
                "start-frontend"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}